#!/usr/bin/env bash
shopt -s nullglob

declare -a files
declare -A seen
recurse=

append() {
  local f=$1
  [[ -z ${seen[$f]} ]] && files+=("$f") && seen[$f]=1
}

read_stdin() {
  local line
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    [[ -f $line ]] && append "$line"
  done
}

# Ingest standard input if piped, redirected, or if no arguments were provided
if [[ ! -t 0 ]]; then
  read_stdin
fi

for arg; do
  if [[ $arg == - ]]; then
    read_stdin
    continue
  fi

  if [[ $arg == -r ]]; then
    recurse=1
    continue
  fi

  if [[ $recurse ]]; then
    while IFS= read -r -d '' f; do append "$f"; done < <(find "$arg" -type f -print0)
    recurse=
  elif [[ -d $arg ]]; then
    for f in "$arg"/*; do [[ -f $f ]] && append "$f"; done
  else
    for f in $arg; do [[ -f $f ]] && append "$f"; done
  fi
done

for f in "${files[@]}"; do
  printf "## %s\n" "$(realpath --relative-to=. "$f")"
  cat "$f"
done
